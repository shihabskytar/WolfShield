{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@wolfshield/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@wolfshield/engine": [
        "../../packages/engine/src/index.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}