{
  "name": "wolfshield",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "test": "pnpm --filter @wolfshield/engine test",
    "typecheck": "pnpm --filter @wolfshield/engine typecheck && pnpm --filter @wolfshield/desktop typecheck",
    "lint": "pnpm --filter @wolfshield/engine lint || true",
    "dev": "pnpm --filter @wolfshield/desktop dev",
    "build": "pnpm --filter @wolfshield/desktop build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}